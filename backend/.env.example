# Copy to .env for local dev. In production set these as real environment variables.
DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=api.example.dev
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Origins allowed to call the API cross-origin. Leave unset if the frontend reaches the API through a same-origin rewrite.
FRONTEND_ORIGINS=https://example.dev
# Reverse proxies in front of gunicorn (so rate limits see the real client IP). Usually 1.
NUM_PROXIES=1
