# Local dev: copy to .env (DEBUG=True is all you need).
# Vercel: set these in the project's environment variables. VERCEL_* vars are provided automatically.
DEBUG=False
SECRET_KEY=change-me
# Your custom domain. *.vercel.app hostnames are accepted automatically on Vercel.
ALLOWED_HOSTS=example.dev
# Set automatically by the Neon (or other Postgres) marketplace integration.
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Only if a frontend on a different origin calls the API. Unused on Vercel, where both share one domain.
# FRONTEND_ORIGINS=https://example.dev
# Reverse proxies in front of the app, for rate limiting. Defaults to 1 on Vercel.
# NUM_PROXIES=1
